<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    
     >

    <com.kookyar.common.LanguagePreference android:key="kookyar_language" />


<CheckBoxPreference 
    
    android:title="@string/pref_mi_title"
    android:defaultValue="false"
    android:key="mi" 
    android:summary="@string/pref_mi_summary"
    />

<ListPreference
    android:title="@string/kookyar_pref_reference_title"
    android:defaultValue="440"
    android:key="ref"
    android:summary="@string/kookyar_pref_reference_summary"
    android:entries="@array/refArray"
    android:entryValues="@array/refArray"/>

<ListPreference 
    android:title="@string/pref_type_title"
    android:defaultValue="سل کوک"
    android:key="type"
    android:summary="@string/pref_type_summary"
    android:entries="@array/typeEntries"
    android:entryValues="@array/typeValues"/>
<ListPreference 
    android:title="@string/kookyar_pref_sensitivity_title"
    android:defaultValue="2"
    android:key="sensitive"
    android:summary="@string/kookyar_pref_sensitivity_summary"
    android:entries="@array/sensitive"
    android:entryValues="@array/sensitivValues"
    />
    <ListPreference
        android:title="@string/pref_changepitch_title"
        android:defaultValue="1"
        android:key="changepitch"
        android:summary="@string/pref_changepitch_summary"
        android:entries="@array/pitchchangeEntries"
        android:entryValues="@array/pitchValues"
        />


</PreferenceScreen>
