<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:fitsSystemWindows="true"
    android:background="@color/windowBackground"
    tools:context=".KookType">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_dastgah"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="کوک بر اساس دستگاه"
                android:textSize="18sp"
                android:textColor="@color/onSurface"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/cardColor"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ketab"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="کوک بر اساس کتاب"
                android:textSize="18sp"
                android:textColor="@color/onSurface"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/cardColor"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
