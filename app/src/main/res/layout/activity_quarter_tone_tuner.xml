<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_quarter_tone"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#16213e"
        app:title="تیونر ربع‌پرده"
        app:titleTextColor="#ffffff"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#ffffff" />

    <!-- Note Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#0f3460"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- Persian Note Name -->
            <TextView
                android:id="@+id/tv_note_name_fa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#e94560"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Western Note Name -->
            <TextView
                android:id="@+id/tv_note_name_en"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="--"
                android:textColor="#aaaaaa"
                android:textSize="18sp"
                android:gravity="center" />

            <!-- Octave -->
            <TextView
                android:id="@+id/tv_octave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#7ec8e3"
                android:textSize="16sp"
                android:gravity="center" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tuning Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="16dp">

        <!-- Cent Deviation -->
        <TextView
            android:id="@+id/tv_cent_deviation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 سنت"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:gravity="center" />

        <!-- Tuning Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="#e94560" />
            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="#f5a623" />
            <View
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:background="#00ff88" />
            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="#f5a623" />
            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="#e94560" />
        </LinearLayout>

        <!-- Needle indicator -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="-35dp">

            <View
                android:id="@+id/needle_indicator"
                android:layout_width="3dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="#ffffff" />
        </FrameLayout>

        <!-- Status Text -->
        <TextView
            android:id="@+id/tv_tuning_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="در انتظار صدا..."
            android:textColor="#aaaaaa"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Frequency Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_frequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- Hz"
            android:textColor="#7ec8e3"
            android:textSize="20sp" />

        <View
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tv_a_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A4 = 440 Hz"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- A4 Reference Control -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#16213e"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فرکانس مرجع لا:"
                android:textColor="#cccccc"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_a_minus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="#ffffff"
                android:textSize="20sp"
                app:cornerRadius="20dp"
                app:strokeColor="#555555" />

            <TextView
                android:id="@+id/tv_a_ref_value"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="440"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_a_plus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#ffffff"
                android:textSize="20sp"
                app:cornerRadius="20dp"
                app:strokeColor="#555555" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
